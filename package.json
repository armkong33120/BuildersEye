{
  "name": "builders-eye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "python3 scripts/build_identity_data.py",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "verify": "node scripts/verify-scene.mjs",
    "dev:backend": "cd server && node --watch index.js",
    "index:hr": "cd server && node index.js --reindex",
    "dev:all": "concurrently -n frontend,backend -c cyan,yellow \"vite --host 0.0.0.0 --port 5174\" \"cd server && node --watch index.js\"",
    "eval:rag": "node eval/run_eval.mjs",
    "test": "node scripts/run_all_tests.mjs",
    "test:api": "node scripts/test_api_rbac_matrix.mjs",
    "test:e2e": "node scripts/test_ui_playwright_headful.mjs",
    "verify:security": "node scripts/verify_security.mjs",
    "test:debug-page": "node scripts/test_debug_page.mjs",
    "benchmark": "node benchmark/runner.mjs",
    "benchmark:generate": "node benchmark/dataset/generate.mjs"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "vite": "^6.0.3"
  }
}
