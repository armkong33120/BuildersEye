# LLM Provider (default: DeepSeek — OpenAI-compatible endpoint)
#   LLM_BASE_URL = https://api.deepseek.com  (DeepSeek)
#   LLM_API_KEY  = your DeepSeek API key (https://platform.deepseek.com/api_keys)
#   LLM_MODEL    = deepseek-chat (default) or deepseek-reasoner
# Legacy OpenAI support (kept for backward compat):
#   OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-chat
# WARNING: DO NOT commit a real key. Rotate any leaked key before deploying.
# Set to "true" to skip LLM and use template answers (for testing)
LLM_SKIP=false

# --- Authentication (SECURITY) ---
# JWT-only (M1). All /api/* routes require a signed access token from /api/auth/login.
# Callers CANNOT forge a role from the request body — role/employeeId come from the JWT.
# (Legacy APP_API_KEY was removed after the JWT transition completed.)
# REQUIRED for per-user login. Set a strong random value:
#   openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (e.g. 15m, 30m, 1h)
ACCESS_TOKEN_TTL=30m
# M4: expose /api/preview/credentials for the demo preview page. "false" in real prod.
ENABLE_TEST_CREDS=true

# --- Deployment (cloud) ---
# Port (Render injects PORT automatically)
PORT=5199
# Path to HR data directory. On Render, point to the repo copy,
# e.g. /opt/render/project/src/src/data/hr_onedrive_demo
HR_DATA_DIR=
# Comma-separated allowed CORS origins (frontend). Add your Vercel URL here.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,https://builders-eye.vercel.app
# Set to "true" to skip the memory-heavy vector index build (low-RAM hosts like Render free tier)
VECTOR_INDEX_DISABLED=false

# --- OneDrive / Webhook (v2) ---
# AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET: from Entra App Registration "BuildersEye-Sync"
# PUBLIC_BACKEND_URL: https://<your-container-app>.azurecontainerapps.io  (webhook notification target)
# WEBHOOK_CLIENT_STATE: random string to verify Graph change notifications
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
PUBLIC_BACKEND_URL=
WEBHOOK_CLIENT_STATE=

# --- Neon Postgres (pgvector) — Source of Truth (ถาวร) ---
# DATABASE_URL from Neon dashboard (Connection string, sslmode=require)
DATABASE_URL=

# --- Application Insights (Azure monitoring, free 5GB) ---
APPINSIGHTS_CONNECTION_STRING=

# Auto-sync รายวัน (ปิดด้วย true)
AUTO_SYNC_DISABLED=false
