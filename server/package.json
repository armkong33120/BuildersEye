{
  "name": "builderseye-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "index:hr": "node index.js --reindex",
    "test": "node test_e2e.js",
    "sync:onedrive": "node sync-onedrive.js",
    "connect:onedrive": "node connect-onedrive.js",
